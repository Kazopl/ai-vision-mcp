#===============================================
# PROVIDER SELECTION
#===============================================
IMAGE_PROVIDER=google # or vertex_ai
VIDEO_PROVIDER=google # or vertex_ai

#===============================================
# MODEL SELECTION
#===============================================
# Default: gemini-3.5-flash-lite (stable, low cost, agentic video capable).
# For harder visual reasoning / OCR use gemini-3.8-flash (latest).
# IMAGE_MODEL=gemini-3.5-flash-lite
# VIDEO_MODEL=gemini-3.5-flash-lite

#===============================================
# FUNCTION-SPECIFIC MODEL SELECTION
#===============================================
# ANALYZE_IMAGE_MODEL=
# COMPARE_IMAGES_MODEL=
# DETECT_OBJECTS_IN_IMAGE_MODEL=
# SEGMENT_OBJECTS_IN_IMAGE_MODEL=
# ANALYZE_VIDEO_MODEL=
# ANALYZE_AUDIO_MODEL=
# Image EDITING model (Nano Banana family; analysis models cannot generate
# images, so this does NOT fall back to IMAGE_MODEL).
# Default gemini-3.1-flash-image (Nano Banana 2: fast, ~95% of Pro quality).
# For maximum quality/text rendering use gemini-3-pro-image (Nano Banana
# Pro: ~2x price, 8-20s, no 512 output size).
# EDIT_IMAGE_MODEL=gemini-3.1-flash-image

#===============================================
# GEMINI API CONFIGURATION (AI Studio)
#===============================================
GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com

#===============================================
# VERTEX AI CONFIGURATION
#===============================================
# Required: Extract these from your service account JSON file
VERTEX_CLIENT_EMAIL=your-service-account@project.iam.gserviceaccount.com
VERTEX_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
VERTEX_PROJECT_ID=your-gcp-project-id
# Optional: defaults to us-central1
# VERTEX_LOCATION=us-central1
# VERTEX_ENDPOINT=https://aiplatform.googleapis.com

#===============================================
# GOOGLE CLOUD STORAGE CONFIGURATION (Required for Vertex AI)
#===============================================
GCS_BUCKET_NAME=your-vision-files-bucket

#===============================================
# UNIVERSAL API PARAMETERS
#===============================================
TEMPERATURE=0.8
TOP_P=0.95
TOP_K=30
MAX_TOKENS=16384

#===============================================
# GEMINI 3+ MEDIA RESOLUTION & THINKING LEVEL
#===============================================
# Token resolution for input media: low | medium | high | ultra_high
# (video: low ~66 tokens/frame, high ~258 tokens/frame + zoomed reframing,
#  which makes small on-screen text like URLs/code readable; ultra_high
#  spends the most tokens for maximum fidelity but is image-only - videos
#  fall back to high)
# MEDIA_RESOLUTION=
# MEDIA_RESOLUTION_FOR_IMAGE=ultra_high
# MEDIA_RESOLUTION_FOR_VIDEO=high

# Reasoning depth: minimal | low | medium | high
# (Gemini 3.5+ Flash defaults to medium; raise for hard OCR, lower for
#  speed. Gemini 3.7+ rejects minimal - it is auto-upgraded to low.)
# THINKING_LEVEL=
# THINKING_LEVEL_FOR_IMAGE=
# THINKING_LEVEL_FOR_VIDEO=

# Video processing mode: agentic | static (default: agentic)
# Agentic video understanding (Gemini 3.6+, 3.5-flash-lite) navigates the
# video on demand instead of ingesting every frame: up to ~97% fewer tokens
# on long videos with equal or better accuracy. videoMetadata (clipping/fps)
# automatically falls back to static; unsupported models use static.
# VIDEO_PROCESSING=agentic

# Agentic Vision default for image analysis: true | false (default: false)
# When enabled, the model runs sandboxed Python to zoom/crop/annotate the
# image itself before answering (Gemini 3+). Also available per call via
# the analyze_image "agenticVision" option. Adds latency.
# AGENTIC_VISION=false

# Safety filter threshold applied to all harm categories (default: API
# defaults). block_none disables probability-based filtering (core
# protections remain) - prevents spurious refusals on legitimate developer
# content such as security errors, tokens, or vulnerability output.
# Values: off | block_none | block_only_high | block_medium_and_above
# SAFETY_THRESHOLD=block_none

# Inference service tier: standard | priority | flex (default: standard)
# priority = lowest latency, non-sheddable, +75-100% price, requires a
# Tier 2/3 paid project (silently downgraded to standard otherwise).
# flex = 50% discount but minutes-level latency (not for interactive use).
# SERVICE_TIER=standard

# HTTP timeout for Gemini API requests in ms (default: 300000 = 5 min,
# generous because agentic vision/video loops can run for minutes)
# GEMINI_TIMEOUT_MS=300000

#===============================================
# TASK-SPECIFIC API PARAMETERS
#===============================================
# TEMPERATURE_FOR_IMAGE=
# TOP_P_FOR_IMAGE=
# TOP_K_FOR_IMAGE=
# MAX_TOKENS_FOR_IMAGE=
# TEMPERATURE_FOR_VIDEO=
# TOP_P_FOR_VIDEO=
# TOP_K_FOR_VIDEO=
# MAX_TOKENS_FOR_VIDEO=

#===============================================
# FUNCTION-SPECIFIC API PARAMETERS
#===============================================
# TEMPERATURE_FOR_ANALYZE_IMAGE=
# TOP_P_FOR_ANALYZE_IMAGE=
# TOP_K_FOR_ANALYZE_IMAGE=
# MAX_TOKENS_FOR_ANALYZE_IMAGE=
# TEMPERATURE_FOR_COMPARE_IMAGES=
# TOP_P_FOR_COMPARE_IMAGES=
# TOP_K_FOR_COMPARE_IMAGES=
# MAX_TOKENS_FOR_COMPARE_IMAGES=
# TEMPERATURE_FOR_DETECT_OBJECTS_IN_IMAGE=
# TOP_P_FOR_DETECT_OBJECTS_IN_IMAGE=
# TOP_K_FOR_DETECT_OBJECTS_IN_IMAGE=
# MAX_TOKENS_FOR_DETECT_OBJECTS_IN_IMAGE=
# TEMPERATURE_FOR_SEGMENT_OBJECTS_IN_IMAGE=
# TOP_P_FOR_SEGMENT_OBJECTS_IN_IMAGE=
# TOP_K_FOR_SEGMENT_OBJECTS_IN_IMAGE=
# MAX_TOKENS_FOR_SEGMENT_OBJECTS_IN_IMAGE=
# TEMPERATURE_FOR_ANALYZE_VIDEO=
# TOP_P_FOR_ANALYZE_VIDEO=
# TOP_K_FOR_ANALYZE_VIDEO=
# MAX_TOKENS_FOR_ANALYZE_VIDEO=

#===============================================
# FILE PROCESSING CONFIGURATION
#===============================================
MAX_IMAGE_SIZE=20971520
MAX_VIDEO_SIZE=2147483648
ALLOWED_IMAGE_FORMATS=png,jpg,jpeg,webp,gif,bmp,tiff
ALLOWED_VIDEO_FORMATS=mp4,mov,avi,mkv,webm,flv,wmv,3gp
MAX_VIDEO_DURATION=3600

#===============================================
# FILE UPLOAD CONFIGURATION
#===============================================
GEMINI_FILES_API_THRESHOLD=10485760
VERTEX_AI_FILES_API_THRESHOLD=0

#===============================================
# FFMPEG (for extract_video_frame only)
#===============================================
# Path to the ffmpeg binary; defaults to "ffmpeg" on PATH
# FFMPEG_PATH=/opt/homebrew/bin/ffmpeg

#===============================================
# INLINE IMAGE PREVIEWS (MCP image content blocks)
#===============================================
# Max dimension for the inline annotated-image preview returned by
# detect_objects_in_image and segment_objects_in_image (0 disables)
# INLINE_IMAGE_MAX_DIM=1200

#===============================================
# LOGGING CONFIGURATION
#===============================================
LOG_LEVEL=info

#===============================================
# DEVELOPMENT CONFIGURATION
#===============================================
NODE_ENV=production # or 'development'
